# PM2 / production — smart-cabinet-presentation
# คัดลอกเป็น frontend/.env แล้ว:
#   npm run build
#   pm2 reload ecosystem.config.cjs --update-env

PORT=7205

NEXTAUTH_SECRET=change-me-openssl-rand-base64-32

# แอปมี basePath → NEXTAUTH_URL ต้องชี้ถึง endpoint ของ NextAuth เต็ม ๆ (ลงท้าย /api/auth)
NEXTAUTH_URL=https://phc.dyndns.biz/smart-cabinet-presentation/api/auth

NEXT_PUBLIC_BASE_PATH=/smart-cabinet-presentation

# เบราว์เซอร์ → API ผ่าน Apache (path ที่ root ของโดเมน)
NEXT_PUBLIC_API_URL=https://phc.dyndns.biz/api/smart-cabinet-presentation/v1

# NextAuth (server-side ตอน login) → backend ตรง LAN 7105
# ห้ามใช้ phc.dyndns.biz เพราะจากเครื่อง sv จะ resolve ออกอินเทอร์เน็ตแล้ว ETIMEDOUT
BACKEND_API_URL=http://10.1.1.10:7105/api/smart-cabinet-presentation/v1
